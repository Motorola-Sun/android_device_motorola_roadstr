<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- the padding on the top of the statusbar (usually 0) -->
    <dimen name="status_bar_padding_top">18px</dimen>

    <!-- Location on the screen of the center of the physical power button. -->
    <dimen name="physical_power_button_center_screen_location_y">1100px</dimen>

    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. -->
    <item format="float" name="pixel_pitch" type="dimen">38.0</item>

    <!-- Padding of the rounded corner content -->
    <dimen name="rounded_corner_content_padding">27px</dimen>

    <!-- Margin from the bottom of the screen to the keyguard indication text -->
    <dimen name="keyguard_indication_margin_bottom">16dip</dimen>
</resources>
